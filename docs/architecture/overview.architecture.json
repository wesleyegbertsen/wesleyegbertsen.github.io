  "cards": [
    {
      "dot": "cyan",
      "title": "Runtime",
      "items": [
        "A client-only single-page app: no server code in this repo",
        "A HashRouter serves / and /projects; unknown addresses go home",
        "The only persisted state is the matrix colour index in localStorage"
      ]
    },
    {
      "dot": "amber",
      "title": "Layout",
      "items": [
        "App keeps the backdrop, menu, mail link, Game Boy and social bar on every page",
        "The menu collapses to a Menu button at 700px wide or less",
        "Menu items and projects are plain data files: add a line to add one"
      ]
    },
    {
      "dot": "emerald",
      "title": "Delivery",
      "items": [
        "Every push and pull request runs check, build and e2e",
        "Deploy needs all three and runs only on main",
        "The custom domain and HTTPS live in the Pages settings, not in a file"
      ]
    },
    {
      "dot": "violet",
      "title": "Tests",
      "items": [
        "Vitest unit tests sit beside the code in src/",
        "Playwright tests the exact dist the build job produced, on desktop and mobile"
      ]
    }
  ]
