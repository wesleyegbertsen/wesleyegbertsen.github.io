  "cards": [
    {
      "dot": "cyan",
      "title": "Runtime",
      "items": [
        "A client-only single-page app: no server code in this repo",
        "The only persisted state is the matrix colour index in localStorage",
        "Sounds start from clicks via a fresh Audio per play"
      ]
    },
    {
      "dot": "emerald",
      "title": "Delivery",
      "items": [
        "Every push and pull request runs build and e2e",
        "The deploy job needs both and runs only on main",
        "The custom domain and HTTPS live in the Pages settings, not in a file"
      ]
    },
    {
      "dot": "violet",
      "title": "Tests",
      "items": [
        "Vitest unit tests sit beside the code in src/",
        "Playwright drives a fresh production build served by vite preview"
      ]
    }
