{
  "profile": "node",
  "baseBranch": "origin/main",
  "checks": [
    { "name": "typecheck", "command": "npm run typecheck", "when": ["src/**", "index.html", "package.json", "package-lock.json", "tsconfig.json", "tsconfig.app.json", "tsconfig.node.json", "vite.config.ts"] },
    { "name": "lint", "command": "npm run lint", "when": ["src/**", "package.json", "package-lock.json", "eslint.config.js"] },
    { "name": "test", "command": "npm test", "when": ["src/**", "index.html", "package.json", "package-lock.json", "vite.config.ts"] },
    { "name": "build", "command": "npm run build", "when": ["src/**", "index.html", "public/**", "package.json", "package-lock.json", "tsconfig.json", "tsconfig.app.json", "tsconfig.node.json", "vite.config.ts"] }
  ]
}
